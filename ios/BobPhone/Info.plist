<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(DARK_ARMY_BUNDLE_ID).refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Dark Army</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(DARK_ARMY_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bobphone</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DarkArmyAppGroup</key>
	<string>group.$(DARK_ARMY_BUNDLE_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Dark Army uses the camera to scan the pairing code shown on your Mac.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Dark Army asks for Face ID each time you open it, before showing anything from your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dark Army talks to your Mac on this Wi-Fi.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dark Army listens while you dictate a card or a reply.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dark Army turns your speech into text, on this phone where your language allows it.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Communication notifications: a buzz from the notification appex
	     wears the agent's portrait in the app icon's place only when the
	     app declares the intent it builds. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
</dict>
</plist>
