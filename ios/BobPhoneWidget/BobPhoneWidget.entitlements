<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same App Group as the app, and nothing else: the widget reads
	     the fleet summary the app wrote, full stop. No push, no Keychain
	     group, no network. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(DARK_ARMY_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
