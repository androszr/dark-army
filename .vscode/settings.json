{
  // Heavy generated trees this checkout keeps on disk. Gitignore is not a
  // watcher exclude — without these, VS Code watches ~29k extra files and
  // the editor hitches. Changing watcherExclude needs a window reload.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/host/.venv/**": true,
    "**/host/dist/**": true,
    "**/host/build/**": true,
    "**/panel/.build/**": true,
    "**/.gitnexus/**": true,
    // Each started card's own checkout folder (card isolation): a whole
    // second tree per card, never watched or searched twice.
    "**/.worktrees/**": true
  },
  "search.exclude": {
    "**/.worktrees/**": true
  }
}
