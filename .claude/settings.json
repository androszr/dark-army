{
  "env": {
    "BOB_SHUNT_MIN_LINES": "1200"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(npm run build:*)",
      "Bash(ruff check:*)",
      "mcp__dark-army",
      "mcp__bob",
      "Bash(cd host && .venv/bin/pytest:*)",
      "Bash(cd panel && swift build:*)",
      "Bash(cd panel && swift test:*)",
      "Bash(cd vscode-extension && npm run build:*)",
      "Bash(python3 tools/ship_efficiency.py inventory:*)",
      "Bash(python3 .claude/skills/scout/scout_check.py:*)",
      "Bash(python3 .claude/skills/ship/manual_check.py:*)"
    ],
    "deny": [
      "Read(~/.dark-army/api-token)",
      "Read(~/.dark-army/relay.json)",
      "Read(~/.dark-army/devices.json)",
      "Read(~/.dark-army/grok-bot.json)",
      "Read(~/.dark-army/grok-bot.secrets)",
      "Read(~/.dark-army/grok-bot-mcp-token)",
      "Read(~/.bob-companion/**)",
      "Read(**/.dark-army/key)",
      "Read(**/.bob-companion/key)",
      "Bash(cat ~/.dark-army/relay.json*)",
      "Bash(cat ~/.dark-army/devices.json*)",
      "Bash(cat ~/.dark-army/grok-bot*)",
      "Bash(cat .dark-army/key*)",
      "Edit(**/.dark-army/worktree-setup.sh)"
    ]
  }
}
