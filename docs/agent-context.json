        "host/dark_army_daemon/decision_store.py",
        "host/tests/test_board*.py",
        "host/tests/test_card_*.py",
        "host/tests/test_dispatch*.py",
        "host/tests/test_outcome*.py",
        "host/tests/test_lifecycle*.py",
        "panel/Sources/BobPanel/Board*.swift",
