  "cross_cutting": [
    {
      "why": "A change to the loopback API, the snapshot or the sealed doors is read by the panel's tolerant decoders and the phone.",
      "paths": [
        "host/dark_army_daemon/api_server.py",
        "host/dark_army_daemon/daemon.py",
        "host/dark_army_daemon/relay*.py",
        "host/dark_army_daemon/devices.py",
        "host/dark_army_daemon/lan_hosts.py"
      ],
      "add": [
        "panel",
        "host"
      ]
    },
    {
      "why": "The board's verbs, the queue and the plan gate are half daemon, half panel; a change on either side reads the board contract.",
      "paths": [
        "host/dark_army_daemon/daemon_board.py",
        "host/dark_army_daemon/dispatch.py",
        "host/dark_army_daemon/board.py",
        "panel/Sources/BobPanel/Board*.swift",
        "ios/BobPhone/Board*.swift"
      ],
      "add": [
        "board",
        "host",
        "panel"
      ]
    },
    {
      "why": "Packaging and the hook handler are what the frozen bundle and the installed copy run; the host contract states what must survive.",
      "paths": [
        "host/setup.py",
        "host/build.sh",
        "host/dark_army_menubar/hooks.py"
      ],
      "add": [
        "host",
        "development"
      ]
    },
    {
      "why": "The session state model is read by both clients; a change to it reads the panel's drawing of it.",
      "paths": [
        "host/dark_army_daemon/session_stats.py",
        "host/dark_army_daemon/daemon.py"
      ],
      "add": [
        "host",
        "panel"
      ]
    }
  ],
  "roles": {
