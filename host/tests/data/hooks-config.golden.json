            "type": "command"
          }
        ],
        "matcher": "Read|Bash|read_file|bash|shell"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "<HOOK_COMMAND>",
            "type": "command"
          }
        ]
      }
    ],
