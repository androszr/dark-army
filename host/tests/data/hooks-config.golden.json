{
  "HOOKS_CONFIG": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "<HOOK_COMMAND>",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      },
      {
        "hooks": [
          {
            "command": "<HOOK_COMMAND>",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "<HOOK_COMMAND>",
            "timeout": 1860,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "<HOOK_COMMAND>",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|ask_user_question"
      }
    ],
    "PostToolUseFailure": [
